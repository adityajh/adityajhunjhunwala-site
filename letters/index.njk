---
layout: base.njk
title: "Letters"
description: "145+ personal letters by Aditya Jhunjhunwala. Every Sunday, something honest about work, life, food, and the inside game. Published since 2020."
pagination:
  data: collections.lettersNewest
  size: 50
  alias: pagedLetters
permalink: "letters/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<div class="page-wrap page-wrap--wide">
  <div class="archive-header">
    <div class="archive-count" style="font-size:0.8rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--gold); margin-bottom:0.5rem;">
      {{ collections.letters | length }} Letters
    </div>
    <h1 style="font-family:var(--font-serif); font-size:clamp(1.75rem,4vw,2.5rem);">Letters from Adi</h1>
    <p style="color:var(--text-muted); max-width:520px; margin-top:0.75rem; font-size:0.9375rem;">
      Every Sunday since 2020. Food, play, love, and the work of building a life. Start anywhere.
    </p>
    <div style="margin-top:1rem;">
      <a href="{{ site.subscribeUrl }}" class="btn btn-primary" target="_blank" rel="noopener" style="font-size:0.875rem;">Subscribe</a>
    </div>
  </div>

  <!-- Search -->
  <div class="search-wrap">
    <div id="search"></div>
  </div>

  <ol class="letter-list" reversed>
    {%- for letter in pagedLetters %}
    <li class="letter-item">
      <span class="letter-item__num">{{ letter.data.letter_number }}</span>
      <span class="letter-item__title">
        <a href="{{ letter.url }}">{{ letter.data.title or "Letter " + letter.data.letter_number }}</a>
      </span>
      {%- if letter.data.date %}
      <span class="letter-item__date">{{ letter.data.date | readableDate }}</span>
      {%- endif %}
    </li>
    {%- endfor %}
  </ol>

  <!-- Pagination -->
  {%- if pagination.pages.length > 1 %}
  <nav style="display:flex; gap:1rem; margin-top:2rem; font-size:0.875rem; align-items:center;">
    {%- if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" style="color:var(--teal);">&larr; Newer</a>
    {%- endif %}
    <span style="color:var(--text-muted);">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {%- if pagination.href.next %}
      <a href="{{ pagination.href.next }}" style="color:var(--teal);">Older &rarr;</a>
    {%- endif %}
  </nav>
  {%- endif %}
</div>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  new PagefindUI({ element: "#search", showSubResults: false, placeholder: "Search letters..." });
</script>
