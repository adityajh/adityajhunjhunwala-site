<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://www.adityajhunjhunwala.com/</loc><priority>1.0</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/letters/</loc><priority>0.9</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/writing/</loc><priority>0.8</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/work/</loc><priority>0.8</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/about/</loc><priority>0.7</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/books/</loc><priority>0.7</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/speaking/</loc><priority>0.7</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/work-with-me/</loc><priority>0.7</priority></url>
  <url><loc>https://www.adityajhunjhunwala.com/subscribe/</loc><priority>0.6</priority></url>
  {%- for letter in collections.letters %}
  <url>
    <loc>https://www.adityajhunjhunwala.com{{ letter.url }}</loc>
    <priority>0.6</priority>
    {%- if letter.data.date %}<lastmod>{{ letter.data.date | htmlDateString }}</lastmod>{%- endif %}
  </url>
  {%- endfor %}
  {%- for article in collections.articles %}
  <url>
    <loc>https://www.adityajhunjhunwala.com{{ article.url }}</loc>
    <priority>0.5</priority>
  </url>
  {%- endfor %}
</urlset>
